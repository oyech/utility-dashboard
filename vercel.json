{
  "framework": "angular",
  "buildCommand": "ng build",
  "outputDirectory": "dist/utility-dashboard/browser",
  "functions": {
    "api/index.js": {
      "includeFiles": "{utility.db,node_modules/sql.js/dist/sql-wasm.wasm}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
